{
  "name": "jsonfmt-editor",
  "private": true,
  "description": "把 CodeMirror 打包成单文件 ../codemirror.js，供 Go 二进制内嵌",
  "scripts": {
    "build": "esbuild editor.js --bundle --format=iife --global-name=CM --minify --outfile=../codemirror.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "esbuild": "^0.25.0"
  }
}
